### ?? Tests Analytics Énergétiques - API Complète
### Fichier: analytics-complete-tests.http

### ========================================
### CONFIGURATION
### ========================================

@baseUrl = https://localhost:7144
@token = {{$dotenv LOGIN_TOKEN}}
@peripheriqueId = 1
@zoneId = 1
@startDate = 2025-01-01
@endDate = 2025-01-07
@tarifKwh = 0.13

### ========================================
### 1. AUTHENTIFICATION
### ========================================

### 1.1 - Login Admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@smartoffice.com",
  "password": "Admin@123"
}

### Copier le token JWT retourné

### ========================================
### 2. STATISTIQUES DE BASE
### ========================================

### 2.1 - Stats par périphérique (7 jours)
# @name getStatsPeripherique
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}
    ?startDate={{startDate}}
    &endDate={{endDate}}
Authorization: Bearer {{token}}

### Expected Response (200 OK):
# {
#   "peripheriqueId": 1,
#   "peripheriqueName": "Climatiseur Salon",
#   "zoneId": 1,
#   "zoneName": "Salon",
#   "consommationTotaleMwh": 145.7,
#   "puissanceMoyenneMw": 6.2,
#   "puissanceMaximaleMw": 8.5,
#   "puissanceMinimaleMw": 3.1,
#   "tempsFonctionnementHeures": 168.5,
#   "efficaciteEnergetique": 0.78,
#   "nombreCycles": 24,
#   "tempsMoyenCycleMinutes": 45.2
# }

### 2.2 - Stats par zone (toute la zone)
GET {{baseUrl}}/api/ConsommationStats/zone/{{zoneId}}
    ?startDate={{startDate}}
    &endDate={{endDate}}
Authorization: Bearer {{token}}

### Expected Response: Agrégation de tous les périphériques de la zone

### 2.3 - ? Test validation: date début >= date fin
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}
    ?startDate=2025-01-07
    &endDate=2025-01-01
Authorization: Bearer {{token}}

### Expected Response (400 Bad Request):
# "La date de début doit être antérieure à la date de fin"

### 2.4 - ? Test validation: périphérique inexistant
GET {{baseUrl}}/api/ConsommationStats/peripherique/99999
    ?startDate={{startDate}}
    &endDate={{endDate}}
Authorization: Bearer {{token}}

### Expected Response (404 Not Found)

### ========================================
### 3. DONNÉES TEMPORELLES
### ========================================

### 3.1 - Consommation horaire (aujourd'hui)
# @name getHoraire
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/horaire
    ?date=2025-01-06
Authorization: Bearer {{token}}

### Expected Response (200 OK): Array de 24 heures
# [
#   {
#     "heure": "2025-01-06T00:00:00Z",
#     "consommationMwh": 5.2,
#     "puissanceMoyenneMw": 6.1,
#     "etatActif": true,
#     "nombreActivations": 2
#   },
#   // ... 24 heures
# ]

### ? Vérifications:
# - Array contient 24 éléments (une heure = un élément)
# - Chaque élément a: heure, consommationMwh, puissanceMoyenneMw
# - etatActif est un booléen
# - nombreActivations >= 0

### 3.2 - Consommation horaire (hier)
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/horaire
    ?date=2025-01-05
Authorization: Bearer {{token}}

### 3.3 - Tendances de consommation (30 derniers jours)
# @name getTendances
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/tendances
    ?nombreJours=30
Authorization: Bearer {{token}}

### Expected Response (200 OK):
# {
#   "peripheriqueId": 1,
#   "peripheriqueName": "Climatiseur Salon",
#   "nombreJours": 30,
#   "consommationQuotidienneMoyenne": 20.8,
#   "tendancePourcentage": 5.2,
#   "consommationPrediteJour": 21.5,
#   "donneesQuotidiennes": [
#     {
#       "date": "2025-01-01T00:00:00Z",
#       "consommationMwh": 19.5,
#       "tempsFonctionnementHeures": 22.3,
#       "puissanceMoyenne": 6.4
#     }
#     // ... 30 jours
#   ]
# }

### 3.4 - Tendances sur 7 jours
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/tendances
    ?nombreJours=7
Authorization: Bearer {{token}}

### 3.5 - Tendances sur 90 jours
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/tendances
    ?nombreJours=90
Authorization: Bearer {{token}}

### 3.6 - ? Test validation: nombreJours trop grand
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/tendances
    ?nombreJours=400
Authorization: Bearer {{token}}

### Expected Response (400 Bad Request):
# "Le nombre de jours doit être entre 1 et 365"

### ========================================
### 4. DÉTECTION D'ANOMALIES
### ========================================

### 4.1 - Anomalies sur 7 jours
# @name getAnomalies
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/anomalies
    ?startDate={{startDate}}
    &endDate={{endDate}}
Authorization: Bearer {{token}}

### Expected Response (200 OK): Array d'anomalies
# [
#   {
#     "peripheriqueId": 1,
#     "peripheriqueName": "Climatiseur Salon",
#     "dateDetection": "2025-01-05T14:30:00Z",
#     "typeAnomalie": "ConsommationElevee",
#     "description": "Consommation 35% supérieure à la moyenne habituelle",
#     "valeurMesuree": 9.2,
#     "valeurAttendue": 6.8,
#     "ecartPourcentage": 35.3,
#     "severite": "High"
#   }
# ]

### ? Vérifications:
# - typeAnomalie: "ConsommationElevee", "ConsommationAnormale", "ArretInattendu"
# - severite: "Low", "Medium", "High"
# - ecartPourcentage >= 0

### 4.2 - Anomalies sur 30 jours
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/anomalies
    ?startDate=2024-12-07
    &endDate={{endDate}}
Authorization: Bearer {{token}}

### 4.3 - Anomalies autre périphérique
GET {{baseUrl}}/api/ConsommationStats/peripherique/2/anomalies
    ?startDate={{startDate}}
    &endDate={{endDate}}
Authorization: Bearer {{token}}

### ========================================
### 5. CALCUL DES COÛTS
### ========================================

### 5.1 - Coût énergétique (tarif 0.13€/kWh)
# @name getCout
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/cout
    ?startDate={{startDate}}
    &endDate={{endDate}}
    &tarifKwh={{tarifKwh}}
Authorization: Bearer {{token}}

### Expected Response (200 OK):
# {
#   "peripheriqueId": 1,
#   "peripheriqueName": "Climatiseur Salon",
#   "consommationMwh": 145.7,
#   "tarifKwh": 0.13,
#   "coutTotal": 18.94,
#   "coutMoyen": 2.71,
#   "coutJournalier": 2.71,
#   "coutsHoraires": [
#     {
#       "heure": "2025-01-06T00:00:00Z",
#       "consommationMwh": 5.2,
#       "tarifKwh": 0.13,
#       "cout": 0.68
#     }
#     // ... heures
#   ]
# }

### 5.2 - Coût avec tarif différent (0.15€/kWh)
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/cout
    ?startDate={{startDate}}
    &endDate={{endDate}}
    &tarifKwh=0.15
Authorization: Bearer {{token}}

### 5.3 - ? Test validation: tarif négatif
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/cout
    ?startDate={{startDate}}
    &endDate={{endDate}}
    &tarifKwh=-0.13
Authorization: Bearer {{token}}

### Expected Response (400 Bad Request):
# "Le tarif kWh doit être positif"

