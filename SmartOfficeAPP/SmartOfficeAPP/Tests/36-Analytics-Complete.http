### ========================================
### 8. COMPARAISON ENTRE PÉRIODES
### ========================================

### 8.1 - Comparer décembre vs janvier
# @name getComparaison
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/comparaison
    ?startDate1=2024-12-01
    &endDate1=2024-12-31
    &startDate2=2025-01-01
    &endDate2=2025-01-31
Authorization: Bearer {{token}}

### Expected Response (200 OK):
# {
#   "peripheriqueId": 1,
#   "peripheriqueName": "Climatiseur Salon",
#   "startDate1": "2024-12-01T00:00:00Z",
#   "endDate1": "2024-12-31T00:00:00Z",
#   "consommationPeriode1Mwh": 138.2,
#   "startDate2": "2025-01-01T00:00:00Z",
#   "endDate2": "2025-01-31T00:00:00Z",
#   "consommationPeriode2Mwh": 145.7,
#   "differenceMwh": 7.5,
#   "differencePourcentage": 5.4,
#   "tendance": "Augmentation",
#   "interpretation": "La consommation a augmenté de 5.4% par rapport à la période précédente"
# }

### ? Vérifications:
# - differenceMwh = consommationPeriode2 - consommationPeriode1
# - differencePourcentage correct
# - tendance: "Augmentation", "Diminution", "Stable"

### 8.2 - Comparer semaines (même mois)
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/comparaison
    ?startDate1=2025-01-01
    &endDate1=2025-01-07
    &startDate2=2025-01-08
    &endDate2=2025-01-14
Authorization: Bearer {{token}}

### 8.3 - ? Test validation: dates inversées période 1
GET {{baseUrl}}/api/ConsommationStats/peripherique/{{peripheriqueId}}/comparaison
    ?startDate1=2025-01-07
    &endDate1=2025-01-01
    &startDate2=2025-01-08
    &endDate2=2025-01-14
Authorization: Bearer {{token}}

### Expected Response (400 Bad Request):
# "Les dates de début doivent être antérieures aux dates de fin"

