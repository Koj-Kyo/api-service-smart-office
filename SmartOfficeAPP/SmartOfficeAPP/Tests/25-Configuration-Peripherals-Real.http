Authorization: Bearer {{token}}

### ====================================
### ÉTAPE 3 : APPLIQUER LA CONFIGURATION RÉELLE
### ====================================

### ?? Configuration des périphériques RÉELS de l'ESP32 v1.3.1
### 
### GPIO RÉELS:
### - LED_RDC       = GPIO 27
### - LED_ETAGE2    = GPIO 26
### - LED_ETAGE3    = GPIO 14
### - SERVO_PIN     = GPIO 13 (Porte)
### - SMOKE_SENSOR  = GPIO 32
### - BUZZER        = GPIO 25
###
### Cette requête met à jour les DESIRED PROPERTIES du Device Twin
### L'ESP32 recevra la configuration et la appliquera automatiquement

PUT {{baseUrl}}/api/Devices/{{deviceId}}/peripherals
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "peripherals": [
    {
      "id": "led-rdc-001",
      "name": "led_rdc",
      "type": "light",
      "gpio": 27,
      "notes": "LED indicateur RDC - Branchée sur GPIO 27",
      "unit": "W",
      "metering": "estimated",
      "ratedWatt": 5,
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "led-etage2-001",
      "name": "led_etage2",
      "type": "light",
      "gpio": 26,
      "notes": "LED indicateur Étage 2 - Branchée sur GPIO 26",
      "unit": "W",
      "metering": "estimated",
      "ratedWatt": 5,
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "led-etage3-001",
      "name": "led_etage3",
      "type": "light",
      "gpio": 14,
      "notes": "LED indicateur Étage 3 - Branchée sur GPIO 14",
      "unit": "W",
      "metering": "estimated",
      "ratedWatt": 5,
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "smoke-sensor-001",
      "name": "smoke_sensor",
      "type": "sensor",
      "gpio": 32,
      "notes": "Capteur de fumée MQ-2 - Branché sur GPIO 32",
      "unit": "ppm",
      "metering": "none",
      "isOutput": false,
      "activeHigh": false
    },
    {
      "id": "servo-door-001",
      "name": "servo_door",
      "type": "servo",
      "gpio": 13,
      "notes": "Servo moteur de la porte - Branché sur GPIO 13 - Angles: 35° (fermé), 175° (ouvert)",
      "unit": "degrees",
      "metering": "none",
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "buzzer-001",
      "name": "buzzer",
      "type": "buzzer",
      "gpio": 25,
      "notes": "Buzzer alarme fumée - Branché sur GPIO 25 - Fréquence: 800 Hz",
      "unit": "Hz",
      "metering": "none",
      "isOutput": true,
      "activeHigh": true
    }
  ]
}

### ====================================
### ÉTAPE 4 : ATTENDRE LA SYNCHRONISATION (10 SECONDES)
### ====================================
### 
### ? ATTENDEZ 10 SECONDES avant de continuer
### 
### Pendant ce temps:
### 1. Azure IoT Hub notifie l'ESP32 des nouvelles desired properties
### 2. L'ESP32 reçoit la configuration via MQTT
### 3. Le firmware exécute applyDesiredPeripherals()
### 4. Chaque GPIO est configuré (pinMode, digitalWrite)
### 5. L'ESP32 publie les REPORTED PROPERTIES
### 6. Le backend lit les nouvelles reported properties
### 
### ? COMPTEZ JUSQU'À 10... 1... 2... 3... 10 ?
### 
### ====================================

### ====================================
### ÉTAPE 5 : VÉRIFIER LA SYNCHRONISATION (APRÈS 10 SECONDES)
### ====================================

### 5.1 - Vérifier que les périphériques sont maintenant corrects
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals
Authorization: Bearer {{token}}

###
PUT https://localhost:7144/api/Devices/mon-esp32/peripherals
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "peripherals": [
    {
      "id": "test-led-001",
      "name": "test_led",
      "type": "light",
      "gpio": 2,
      "isOutput": true,
      "activeHigh": true,
      "metering": "none"
    }
  ]
}
###
GET {{baseUrl}}/api/IoTHub/device/{{deviceId}}/twin
Authorization: Bearer {{token}}

###
GET {{baseUrl}}/api/DeviceLogs/{{deviceId}}?level=error
Authorization: Bearer {{token}}
### 5.2 - Vérifier le Device Twin complet (desired + reported)
GET {{baseUrl}}/api/Devices/{{deviceId}}/twin/full
Authorization: Bearer {{token}}

###

### 5.3 - Vue fusionnée LED Étage 2 (desired vs reported)
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage2/merged
Authorization: Bearer {{token}}

###

### 5.4 - Vue fusionnée LED Étage 3 (desired vs reported)
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage3/merged
Authorization: Bearer {{token}}

###

### 5.5 - Vue fusionnée LED RDC (desired vs reported)
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_rdc/merged
Authorization: Bearer {{token}}

### ====================================
### ÉTAPE 6 : TESTER LE CONTRÔLE DES PÉRIPHÉRIQUES
### ====================================

### 6.1 - Test LED Étage 2 (GPIO 26)
POST {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage2/commands/on
Authorization: Bearer {{token}}

###
# ? VÉRIFICATION PHYSIQUE: La LED sur GPIO 26 doit s'allumer
# Attendez 2 secondes pour voir le résultat

###

### 6.2 - Vérifier l'état de la LED Étage 2
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage2
Authorization: Bearer {{token}}

###
# Résultat attendu:
# {
#   "name": "led_etage2",
#   "state": "on",
#   "configured": true,
#   "lastUpdate": "2025-01-23T16:30:00Z"
# }

###

### 6.3 - Éteindre LED Étage 2
POST {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage2/commands/off
Authorization: Bearer {{token}}

###

### 6.4 - Test LED Étage 3 (GPIO 14)
POST {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage3/commands/on
Authorization: Bearer {{token}}

###
# ? VÉRIFICATION PHYSIQUE: La LED sur GPIO 14 doit s'allumer

###

### 6.5 - Test LED RDC (GPIO 27)
POST {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_rdc/commands/on
Authorization: Bearer {{token}}

###
# ? VÉRIFICATION PHYSIQUE: La LED sur GPIO 27 doit s'allumer

### ====================================
### ÉTAPE 7 : TESTER LA PORTE (SERVO)
### ====================================

### 7.1 - Ouvrir la porte (Servo 175°)
POST {{baseUrl}}/api/IoTHub/device/{{deviceId}}/method/openDoor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payload": "{}"
}

###
# ? VÉRIFICATION PHYSIQUE: Le servo doit se positionner à 175°

###

### 7.2 - Vérifier l'état global du device
POST {{baseUrl}}/api/IoTHub/device/{{deviceId}}/method/getStatus
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payload": "{}"
}

###
# Résultat attendu:
# {
#   "firmware": {
#     "version": "1.3.1",
#     "commit": "prod2025-fixed"
