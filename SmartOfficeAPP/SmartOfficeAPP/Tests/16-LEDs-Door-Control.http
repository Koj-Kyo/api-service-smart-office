### ====================================
### ?? VÉRIFICATIONS
### ====================================

### 18. ?? Vérifier l'état de la LED Étage 2
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage2
Authorization: Bearer {{token}}

###

### 19. ?? Vérifier l'état de la LED Étage 3
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage3
Authorization: Bearer {{token}}

###

### 20. ?? Vérifier l'état de la porte (via getStatus)
# ? CORRIGÉ
POST {{baseUrl}}/api/IoTHub/device/{{deviceId}}/method/getStatus
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payload": "{}"
}

###

### 21. ?? Vue fusionnée LED Étage 2 (desired + reported)
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage2/merged
Authorization: Bearer {{token}}

###

### 22. ?? Vue fusionnée LED Étage 3 (desired + reported)
GET {{baseUrl}}/api/Devices/{{deviceId}}/peripherals/led_etage3/merged
Authorization: Bearer {{token}}

