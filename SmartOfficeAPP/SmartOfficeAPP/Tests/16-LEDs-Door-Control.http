Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payload": "{}"
}

###

### 12. ?? Fermer la porte (Servo 35°)
# ? CORRIGÉ: Route et payload mis à jour
POST {{baseUrl}}/api/IoTHub/device/{{deviceId}}/method/closeDoor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payload": "{}"
}

###

### 13. ?? Basculer l'état de la porte (toggle)
# Si ouverte ? ferme, si fermée ? ouvre
# ? CORRIGÉ: Route et payload mis à jour
POST {{baseUrl}}/api/IoTHub/device/{{deviceId}}/method/openDoor
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "payload": "{}"
}

### ====================================
### ??? SCÉNARIOS COMBINÉS
### ====================================

