Authorization: Bearer {{token}}
Content-Type: application/json

"En cours"

###
PUT {{baseUrl}}/api/IncidentTickets/{{ticketId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

"En attente"

###
PUT {{baseUrl}}/api/IncidentTickets/{{ticketId}}/status
Authorization: Bearer {{token}}
Content-Type: application/json

"Résolu"

