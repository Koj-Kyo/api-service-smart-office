### ========================================
### AUTHENTICATION TESTS
### ========================================

### 1. Register new user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "TestPassword123!",
  "confirmPassword": "TestPassword123!",
  "Username" : "jake",
  "fullName": "Test User"
}

### 2. Register new admin user
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "adminator@smartoffice.com",
  "password": "AdminPassword123!",
  "confirmPassword": "AdminPassword123!",
  "Username" : "GoatAdmin",
  "fullName": "Admin User"
}

### 3. Login user
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "TestPassword123!"
}

### 4. Login admin
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "adminer@smartoffice.com",
  "password": "Admin1234!"
}

### 5. Test authentication (requires valid token)
GET {{baseUrl}}/api/auth/test-auth
Authorization: Bearer {{userToken}}

### 6. Test admin authorization (requires admin token)
GET {{baseUrl}}/api/auth/test-admin
Authorization: Bearer {{adminToken}}

### 7. Test invalid token
GET {{baseUrl}}/api/auth/test-auth
Authorization: Bearer invalid_token_here

### 8. Test register with invalid data
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "invalidemail",
  "password": "weak",
  "confirmPassword": "different",
  "fullName": ""
}

### 9. Test login with invalid credentials
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "WrongPassword123!"
}

### 10. Test register with existing email
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "AnotherPassword123!",
  "confirmPassword": "AnotherPassword123!",
  "UserName": "jake",
  "fullName": "Another User"
}