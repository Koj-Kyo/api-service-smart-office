### ÉTAPE 8 : VALIDATION COMPLÈTE
### ====================================

### 8.1 - Test configuration complète ESP32
PUT {{baseUrl}}/api/Devices/{{deviceId}}/peripherals
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "peripherals": [
    {
      "id": "led-rdc-001",
      "name": "led_rdc",
      "type": "light",
      "gpio": 27,
      "notes": "LED indicateur RDC - Format camelCase",
      "unit": "W",
      "metering": "estimated",
      "ratedWatt": 5,
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "led-etage2-001",
      "name": "led_etage2",
      "type": "light",
      "gpio": 26,
      "notes": "LED indicateur Étage 2",
      "unit": "W",
      "metering": "estimated",
      "ratedWatt": 5,
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "led-etage3-001",
      "name": "led_etage3",
      "type": "light",
      "gpio": 14,
      "notes": "LED indicateur Étage 3",
      "unit": "W",
      "metering": "estimated",
      "ratedWatt": 5,
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "smoke-sensor-001",
      "name": "smoke_sensor",
      "type": "sensor",
      "gpio": 32,
      "notes": "Capteur de fumée MQ-2",
      "unit": "ppm",
      "metering": "none",
      "isOutput": false,
      "activeHigh": false
    },
    {
      "id": "servo-door-001",
      "name": "servo_door",
      "type": "servo",
      "gpio": 13,
      "notes": "Servo moteur porte",
      "unit": "degrees",
      "metering": "none",
      "isOutput": true,
      "activeHigh": true
    },
    {
      "id": "buzzer-001",
      "name": "buzzer",
      "type": "buzzer",
      "gpio": 25,
      "notes": "Buzzer alarme",
      "unit": "Hz",
      "metering": "none",
      "isOutput": true,
      "activeHigh": true
    }
  ]
}

