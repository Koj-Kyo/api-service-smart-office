#         accessTokenFactory: () => "{{userToken}}"
#     })
#     .build();

### 2. Test SignalR group subscription (JavaScript example)
# await connection.invoke("JoinGroup", "zone_1");

### 3. Test SignalR leave group (JavaScript example)
# await connection.invoke("LeaveGroup", "zone_1");

