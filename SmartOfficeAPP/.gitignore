## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/master/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017 cache/options directory
.vs/

# Visual Studio Code
.vscode/

# Rider
.idea/

# User secrets
appsettings.Development.json
appsettings.*.json
!appsettings.json

# =========================================
# ?? AZURE DEPLOYMENT SECRETS - CRITICAL
# =========================================
.env
.env.local
.env.*.local
*.env

# Azure Developer CLI
.azure/

# Bicep compiled files
*.bicep.json

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# Azure Functions
local.settings.json

# Connection strings and secrets
connectionstrings.json
secrets.json

# =========================================
# Package Management
# =========================================
[Pp]ackages/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# NuGet
*.nuget.props
*.nuget.targets

# =========================================
# Database
# =========================================
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# =========================================
# Others
# =========================================
*.cache
*.log
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Node.js (si vous avez un frontend)
node_modules/
npm-debug.log
yarn-error.log

# macOS
.DS_Store

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
