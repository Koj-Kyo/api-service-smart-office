# =========================================
# ?? SmartOffice API - Variables d'environnement
# À configurer avant le déploiement
# =========================================

# Azure Subscription (obtenir via : az account show --query id -o tsv)
AZURE_SUBSCRIPTION_ID=

# Région de déploiement
AZURE_LOCATION=eastus

# Nom du Resource Group (sera créé automatiquement)
AZURE_RESOURCE_GROUP=smartoffice-prod-rg

# Environnement
AZURE_ENV_NAME=prod

# =========================================
# ?? Secrets requis (NE PAS COMMITTER)
# =========================================

# PostgreSQL Admin Password (minimum 8 caractères, majuscule, minuscule, chiffre)
POSTGRESQL_ADMIN_PASSWORD=

# JWT Secret (256 bits recommandé)
JWT_SECRET=

# IoT Hub Connection String (si vous utilisez IoT Hub existant)
IOTHUB_CONNECTION_STRING=

# Storage Account Connection String (pour checkpoints Event Hub)
STORAGE_CONNECTION_STRING=

# =========================================
# ?? Instructions de configuration
# =========================================

# 1. Copier ce fichier en .env dans le répertoire racine
#    cp .env.example .env

# 2. Remplir les valeurs des secrets ci-dessus

# 3. Charger les variables d'environnement :
#    Windows PowerShell :
#      Get-Content .env | ForEach-Object { if ($_ -match '^([^=]+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') } }
#    
#    Linux/Mac :
#      export $(cat .env | xargs)

# 4. Lancer le déploiement :
#    azd up

# =========================================
# ?? SÉCURITÉ IMPORTANTE
# =========================================
# ??  Ajouter .env au .gitignore
# ??  Ne JAMAIS committer les secrets
# ??  Utiliser Azure Key Vault en production
